{
  "entities": {
    "User": {
      "title": "User",
      "description": "Medical platform authenticated user record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["PATIENT", "DOCTOR", "CUSTOMER_SERVICE", "HOSPITAL_ADMIN"] },
        "nationalId": { "type": "string" },
        "avatar": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "fullName", "email", "role"]
    },
    "Patient": {
      "title": "Patient",
      "description": "Medical patient electronic health record profile and history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "mrn": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "bloodType": { "type": "string" },
        "birthDate": { "type": "string" },
        "gender": { "type": "string" },
        "chronicDiseases": { "type": "array", "items": { "type": "string" } },
        "allergies": { "type": "array", "items": { "type": "string" } },
        "emergencyContact": { "type": "object" },
        "address": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "mrn", "fullName", "phone"]
    },
    "Doctor": {
      "title": "Doctor",
      "description": "Healthcare provider consultant or specialist profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "title": { "type": "string" },
        "specialtyId": { "type": "string" },
        "specialtyNameAr": { "type": "string" },
        "specialtyNameEn": { "type": "string" },
        "qualifications": { "type": "array", "items": { "type": "string" } },
        "experienceYears": { "type": "number" },
        "consultationFee": { "type": "number" },
        "rating": { "type": "number" },
        "roomNumber": { "type": "string" },
        "availableDays": { "type": "array", "items": { "type": "string" } },
        "availableHours": { "type": "string" },
        "isActive": { "type": "boolean" },
        "avatar": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "fullName", "specialtyId"]
    },
    "Staff": {
      "title": "Staff",
      "description": "Customer service coordinator or hospital administrative staff",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "department": { "type": "string" },
        "roleTitle": { "type": "string" },
        "shift": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "isActive": { "type": "boolean" },
        "avatar": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "fullName"]
    },
    "Specialty": {
      "title": "Specialty",
      "description": "Medical specialty department",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nameAr": { "type": "string" },
        "nameEn": { "type": "string" },
        "descriptionAr": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "nameAr"]
    },
    "MedicalService": {
      "title": "MedicalService",
      "description": "Hospital medical consultation or examination service",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "specialtyId": { "type": "string" },
        "nameAr": { "type": "string" },
        "nameEn": { "type": "string" },
        "price": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "category": { "type": "string" },
        "descriptionAr": { "type": "string" },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "nameAr", "price"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Financial payment transaction records for bookings and medical consultations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "patientPhone": { "type": "string" },
        "serviceType": { "type": "string", "enum": ["APPOINTMENT_BOOKING", "MEDICAL_CONSULTATION", "LAB_TEST", "PROCEDURE"] },
        "appointmentId": { "type": "string" },
        "consultationId": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "doctorSpecialty": { "type": "string" },
        "serviceName": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "paymentMethod": { "type": "string", "enum": ["CREDIT_CARD", "MADA", "APPLE_PAY", "STC_PAY", "WAIVED", "CASH", "INSURANCE"] },
        "paymentStatus": { "type": "string", "enum": ["PAYMENT_REQUIRED", "PAYMENT_PENDING", "PAYMENT_SUCCESS", "PAYMENT_FAILED", "PAYMENT_CANCELLED", "REFUND_PENDING", "REFUNDED", "WAIVED"] },
        "transactionReference": { "type": "string" },
        "gatewayTransactionId": { "type": "string" },
        "gatewayProvider": { "type": "string" },
        "waivedBy": { "type": "string" },
        "waivedReason": { "type": "string" },
        "receiptUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "confirmedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "patientId", "doctorId", "amount", "currency", "paymentMethod", "paymentStatus", "transactionReference"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Clinic and telemedicine appointment booking record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "patientPhone": { "type": "string" },
        "patientMrn": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "doctorSpecialty": { "type": "string" },
        "serviceId": { "type": "string" },
        "serviceName": { "type": "string" },
        "preferredDate": { "type": "string" },
        "preferredPeriod": { "type": "string" },
        "confirmedDate": { "type": "string" },
        "confirmedTime": { "type": "string" },
        "clinicRoom": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string" },
        "paymentId": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "paymentAmount": { "type": "number" },
        "currency": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "transactionReference": { "type": "string" },
        "isWaived": { "type": "boolean" },
        "waiverReason": { "type": "string" },
        "rescheduleRequestedDate": { "type": "string" },
        "coordinatorNotes": { "type": "string" },
        "patientNotes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "patientId", "doctorId", "reason", "status"]
    },
    "Consultation": {
      "title": "Consultation",
      "description": "Medical online consultation request, doctor clinical response and messages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "patientPhone": { "type": "string" },
        "patientMrn": { "type": "string" },
        "patientAge": { "type": "number" },
        "patientGender": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "doctorSpecialty": { "type": "string" },
        "title": { "type": "string" },
        "problemDescription": { "type": "string" },
        "symptoms": { "type": "array", "items": { "type": "string" } },
        "duration": { "type": "string" },
        "status": { "type": "string" },
        "consultationFee": { "type": "number" },
        "currency": { "type": "string" },
        "paymentId": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "transactionReference": { "type": "string" },
        "doctorAdvice": { "type": "string" },
        "doctorNotes": { "type": "string" },
        "treatmentPlan": { "type": "string" },
        "suggestedAction": { "type": "string" },
        "requireInPersonVisit": { "type": "boolean" },
        "attachments": { "type": "array", "items": { "type": "object" } },
        "messages": { "type": "array", "items": { "type": "object" } },
        "answeredAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "patientId", "doctorId", "title", "problemDescription", "status"]
    },
    "FollowUpAppointment": {
      "title": "FollowUpAppointment",
      "description": "Doctor-scheduled follow up visits for patient medical review",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "patientPhone": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "doctorSpecialty": { "type": "string" },
        "originalAppointmentId": { "type": "string" },
        "originalConsultationId": { "type": "string" },
        "followUpDate": { "type": "string" },
        "followUpTime": { "type": "string" },
        "reason": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["SCHEDULED", "REMINDED", "CONFIRMED", "COMPLETED", "CANCELLED"] },
        "reminderSettings": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "patientId", "doctorId", "followUpDate", "status"]
    },
    "Refund": {
      "title": "Refund",
      "description": "Financial refund transactions for cancelled bookings and consultations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "paymentId": { "type": "string" },
        "appointmentId": { "type": "string" },
        "consultationId": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["REFUND_PENDING", "REFUNDED", "REJECTED"] },
        "initiatedBy": { "type": "string" },
        "initiatedByName": { "type": "string" },
        "initiatedByRole": { "type": "string" },
        "transactionReference": { "type": "string" },
        "gatewayRefundId": { "type": "string" },
        "createdAt": { "type": "string" },
        "confirmedAt": { "type": "string" }
      },
      "required": ["id", "paymentId", "patientId", "amount", "reason", "status"]
    },
    "ReminderSchedule": {
      "title": "ReminderSchedule",
      "description": "Automated appointment and follow up alert schedules",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "appointmentId": { "type": "string" },
        "followUpId": { "type": "string" },
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "targetDateTime": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "offsetsMinutes": { "type": "array", "items": { "type": "number" } },
        "sentOffsets": { "type": "array", "items": { "type": "number" } },
        "channels": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "patientId", "targetDateTime", "status"]
    },
    "MedicalExamination": {
      "title": "MedicalExamination",

      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "referenceId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "transactionReference": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System security, financial, and administrative action audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "action": { "type": "string" },
        "resourceType": { "type": "string" },
        "resourceId": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Authenticated user accounts collection"
    },
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Patient EHR medical history collection"
    },
    "/doctors/{doctorId}": {
      "schema": "Doctor",
      "description": "Doctors and medical consultants directory"
    },
    "/staff/{staffId}": {
      "schema": "Staff",
      "description": "Customer service coordinators and administrative staff"
    },
    "/specialties/{specialtyId}": {
      "schema": "Specialty",
      "description": "Medical specialty departments list"
    },
    "/services/{serviceId}": {
      "schema": "MedicalService",
      "description": "Hospital medical clinic services"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Secure financial payments collection"
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Scheduled in-clinic and virtual appointments bookings"
    },
    "/consultations/{consultationId}": {
      "schema": "Consultation",
      "description": "Patient medical consultations and doctor clinical replies"
    },
    "/followUpAppointments/{followUpId}": {
      "schema": "FollowUpAppointment",
      "description": "Doctor scheduled follow-up visits"
    },
    "/refunds/{refundId}": {
      "schema": "Refund",
      "description": "Financial refund requests and executions"
    },
    "/reminderSchedules/{reminderId}": {
      "schema": "ReminderSchedule",
      "description": "Automated notification reminder schedules"
    },
    "/examinations/{examinationId}": {
      "schema": "MedicalExamination",
      "description": "Clinical examinations and diagnoses"
    },
    "/tests/{testId}": {
      "schema": "MedicalTest",
      "description": "Laboratory and diagnostic tests"
    },
    "/reports/{reportId}": {
      "schema": "MedicalReport",
      "description": "Official medical reports and certificates"
    },
    "/prescriptions/{prescriptionId}": {
      "schema": "Prescription",
      "description": "Electronic prescriptions"
    },
    "/notifications/{notificationId}": {
      "schema": "AppNotification",
      "description": "User multi-role notifications"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Platform immutable audit trails"
    }
  }
}
